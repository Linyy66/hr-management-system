<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.hr.mapper.PositionMapper">

    <!-- 通用查询列 -->
    <sql id="Base_Column_List">
        id, name, job_id, sort, remark, create_time, update_time
    </sql>

    <!-- 分页查询岗位 -->
    <select id="queryPosPage" parameterType="com.example.hr.dto.PositionQueryDTO" resultType="com.example.hr.entity.Position">
        SELECT
        <include refid="Base_Column_List"/>
        FROM position
        <where>
            <if test="jobId != null">
                AND job_id = #{jobId}
            </if>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
        </where>
        ORDER BY sort ASC
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <!-- 根据职位ID查询 -->
    <select id="selectByJobId" parameterType="java.lang.Long" resultType="com.example.hr.entity.Position">
        SELECT
        <include refid="Base_Column_List"/>
        FROM position
        WHERE job_id = #{jobId}
        ORDER BY sort ASC
    </select>

    <!-- 根据ID查询 -->
    <select id="selectById" parameterType="java.lang.Long" resultType="com.example.hr.entity.Position">
        SELECT
        <include refid="Base_Column_List"/>
        FROM position
        WHERE id = #{id}
    </select>

    <!-- 新增岗位 -->
    <insert id="insert" parameterType="com.example.hr.entity.Position" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO position (
            name, job_id, sort, remark, create_time, update_time
        ) VALUES (
                     #{name}, #{jobId}, #{sort}, #{remark}, NOW(), NOW()
                 )
    </insert>

    <!-- 更新岗位 -->
    <update id="update" parameterType="com.example.hr.entity.Position">
        UPDATE position
        SET
            name = #{name},
            job_id = #{jobId},
            sort = #{sort},
            remark = #{remark},
            update_time = NOW()
        WHERE id = #{id}
    </update>

    <!-- 删除岗位 -->
    <delete id="delete" parameterType="java.lang.Long">
        DELETE FROM position WHERE id = #{id}
    </delete>
</mapper>