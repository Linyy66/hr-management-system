<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.hr.mapper.DepartmentMapper">

    <!-- 通用查询列 -->
    <sql id="Base_Column_List">
        id, name, parent_id, sort, remark, create_time, update_time
    </sql>

    <!-- 分页查询部门 -->
    <select id="queryDeptPage" parameterType="com.example.hr.dto.DepartmentQueryDTO" resultType="com.example.hr.entity.Department">
        SELECT
        <include refid="Base_Column_List"/>
        FROM department
        <if test="name != null and name != ''">
            WHERE name LIKE CONCAT('%', #{name}, '%')
        </if>
        ORDER BY sort ASC, create_time DESC
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <!-- 查询所有部门 -->
    <select id="selectAll" resultType="com.example.hr.entity.Department">
        SELECT
        <include refid="Base_Column_List"/>
        FROM department
        ORDER BY sort ASC
    </select>

    <!-- 根据ID查询 -->
    <select id="selectById" parameterType="java.lang.Long" resultType="com.example.hr.entity.Department">
        SELECT
        <include refid="Base_Column_List"/>
        FROM department
        WHERE id = #{id}
    </select>

    <!-- 根据名称查询 -->
    <select id="selectByName" parameterType="java.lang.String" resultType="com.example.hr.entity.Department">
        SELECT
        <include refid="Base_Column_List"/>
        FROM department
        WHERE name = #{name}
    </select>

    <!-- 新增部门 -->
    <insert id="insert" parameterType="com.example.hr.entity.Department" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO department (
            name, parent_id, sort, remark, create_time, update_time
        ) VALUES (
                     #{name}, #{parentId}, #{sort}, #{remark}, NOW(), NOW()
                 )
    </insert>

    <!-- 更新部门 -->
    <update id="update" parameterType="com.example.hr.entity.Department">
        UPDATE department
        SET
            name = #{name},
            parent_id = #{parentId},
            sort = #{sort},
            remark = #{remark},
            update_time = NOW()
        WHERE id = #{id}
    </update>

    <!-- 删除部门 -->
    <delete id="delete" parameterType="java.lang.Long">
        DELETE FROM department WHERE id = #{id}
    </delete>

    <!-- 统计子部门数量 -->
    <select id="countChildren" parameterType="java.lang.Long" resultType="java.lang.Integer">
        SELECT COUNT(id) FROM department WHERE parent_id = #{parentId}
    </select>
</mapper>